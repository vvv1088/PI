@@ -0,0 +1,141 @@
+/**
+ * MIS（Marketing Intelligence System）跨域只读接入。
+ *
+ * 背景：MIS dashboard（静态单文件，部署在 cPanel）需要跨域调用本系统的
+ * 只读接口取事实数据（资产状态 / 花费报表等）。本模块提供：
+ *   1. CORS 白名单判定与响应头（仅放行 MIS 域名，不用通配符）
+ *   2. Bearer service token 校验 → 合成一个只读的 SessionPayload
+ *
+ * 与 permission-rules.ts 同样是纯数据/纯函数模块，不引入任何
+ * server-only 依赖（bcrypt/prisma），可安全用于 Edge middleware。
+ *
+ * 环境变量（三个都不设 = 本功能整体关闭，行为与改造前完全一致）：
+ *   MIS_ALLOWED_ORIGIN   允许跨域的来源，如 https://ci.boostmarketing.site
+ *                        多个来源用逗号分隔（预留联调用）
+ *   MIS_API_TOKEN        MIS 专用 service token（建议 ≥48 位随机字符串）
+ *   MIS_ALLOW_REMARK_PUT 设为 "1" 时，额外放行 PUT /api/analytics/spending/remark
+ *                        （花费报表人工备注；默认关闭，见对接清单 E 节「唯一的写例外」）
+ */
+import type { PermissionMap, SessionPayload } from "@/lib/session";
+
+/** token 身份在 action_logs / 排查时显示的名字 */
+export const MIS_SERVICE_NAME = "mis-service";
+/** 合成 session 的 uid（users 表里不存在的保留值，仅用于标识） */
+export const MIS_SERVICE_UID = "mis-service";
+
+/**
+ * MIS token 的权限面（全部 view）。
+ * 刻意排除（连 view 都不给）：
+ *   tokens      —— GET /api/tokens 明文返回 access token（已知问题 14 §2）
+ *   users       —— 用户管理与 MIS 无关
+ *   action-logs —— 明文渲染 token / app secret（已知问题 14 §2）
+ */
+export const MIS_READONLY_PERMS: PermissionMap = {
+  brands: "view",
+  "business-managers": "view",
+  pixels: "view",
+  "ad-accounts": "view",
+  "developer-apps": "view",
+  tokens: "none",
+  "pixel-shares": "view",
+  rotation: "view",
+  health: "view",
+  sop: "view",
+  users: "none",
+  "action-logs": "none",
+  "analytics-accounts": "view",
+  "analytics-ads": "view",
+  "analytics-brands": "view",
+  "analytics-spending": "view",
+  "analytics-lifecycle": "view",
+};
+
+/** 无论权限如何，token 身份一律拒绝的路径前缀（纵深防御，与上面的 none 双保险） */
+export const MIS_DENIED_API_PREFIXES = [
+  "/api/auth",
+  "/api/tokens",
+  "/api/users",
+  "/api/action-logs",
+];
+
+const REMARK_PUT_PATH = "/api/analytics/spending/remark";
+
+function allowedOrigins(): string[] {
+  const raw = process.env.MIS_ALLOWED_ORIGIN;
+  if (!raw) return [];
+  return raw
+    .split(",")
+    .map((s) => s.trim().replace(/\/+$/, ""))
+    .filter(Boolean);
+}
+
+/** 请求的 Origin 是否在白名单内（精确匹配，无通配符） */
+export function isMisOriginAllowed(origin: string | null): boolean {
+  if (!origin) return false;
+  return allowedOrigins().includes(origin.replace(/\/+$/, ""));
+}
+
+/** 生成 CORS 响应头。仅在 isMisOriginAllowed 通过后调用。 */
+export function misCorsHeaders(origin: string): Record<string, string> {
+  return {
+    "Access-Control-Allow-Origin": origin,
+    "Access-Control-Allow-Methods": "GET,PUT,OPTIONS",
+    "Access-Control-Allow-Headers": "Authorization, Content-Type",
+    "Access-Control-Max-Age": "86400",
+    Vary: "Origin",
+  };
+}
+
+function timingSafeEqualStr(a: string, b: string): boolean {
+  const enc = new TextEncoder();
+  const ab = enc.encode(a);
+  const bb = enc.encode(b);
+  // 长度不同直接失败（长度本身不是秘密）
+  if (ab.length !== bb.length) return false;
+  let diff = 0;
+  for (let i = 0; i < ab.length; i += 1) diff |= ab[i] ^ bb[i];
+  return diff === 0;
+}
+
+/**
+ * 校验 Authorization: Bearer <token>。
+ * 通过 → 返回合成的只读 SessionPayload；未配置 MIS_API_TOKEN 或不匹配 → null。
+ */
+export function verifyMisToken(authorization: string | null): SessionPayload | null {
+  const expected = process.env.MIS_API_TOKEN;
+  if (!expected || expected.length < 32) return null; // 未配置或弱 token = 功能关闭
+  if (!authorization || !authorization.startsWith("Bearer ")) return null;
+  const provided = authorization.slice("Bearer ".length).trim();
+  if (!provided || !timingSafeEqualStr(provided, expected)) return null;
+  const now = Date.now();
+  return {
+    uid: MIS_SERVICE_UID,
+    name: MIS_SERVICE_NAME,
+    perms: MIS_READONLY_PERMS,
+    iat: now,
+    exp: now + 1000 * 60 * 5, // 每个请求独立校验，exp 仅为满足类型
+  };
+}
+
+/**
+ * token 身份的方法/路径限制：
+ *   - 只允许 /api/* （页面路由一律拒绝）
+ *   - 只允许 GET；MIS_ALLOW_REMARK_PUT=1 时额外允许 PUT /api/analytics/spending/remark
+ *   - MIS_DENIED_API_PREFIXES 一律拒绝
+ * 返回 null = 放行；返回字符串 = 拒绝原因（写进 403 响应，便于联调排查）。
+ */
+export function misRequestViolation(method: string, pathname: string): string | null {
+  if (!pathname.startsWith("/api/")) return "service token only allows /api/* routes";
+  if (MIS_DENIED_API_PREFIXES.some((p) => pathname.startsWith(p))) {
+    return "this route is not available to the MIS service token";
+  }
+  if (method === "GET") return null;
+  if (
+    method === "PUT" &&
+    pathname === REMARK_PUT_PATH &&
+    process.env.MIS_ALLOW_REMARK_PUT === "1"
+  ) {
+    return null;
+  }
+  return "service token is read-only";
+}
