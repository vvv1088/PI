根因:①resource-service 的 disabledData 只改 status 不清 role,列表页红色
Disable 会重新制造「BANNED 但 role=MAIN」脏数据(手册 §3.1 B1);
②轮转递补 findFirst 只排除 BANNED,DISABLED 的备份仍会被提升(§5.2 R1 残留);
③对已 BANNED 目标重复执行轮转不报错,静默重跑并重复生成整组 SOP 与
rotation_log(§5.2 R3 残留;2026-08 的角色感知修复已消除双 MAIN,幂等仍缺)。

证据:06-API接口手册 §3.1「已知缺陷 B1」、§5.5「遗留项 2/3」逐条对照;
resource-service.ts 的 businessManagers/pixels disabledData 与两条
rotation route 的 findFirst 条件为现行代码实况。

改法:①两处 disabledData 补 role:null;②递补查询 status 条件收紧为
"ACTIVE";③目标查询加 status:{not:"BANNED"},已封目标返回明确错误。

验证:npx tsc --noEmit 与 npm run build 均通过(0 错误);
按 §5.2/§5.3 坑位表逐条核对:B1/R1/R3 路径全部闭合,R2 维持已修状态。
---
 src/app/api/rotation/execute-pixel/route.ts |  8 +++++---
 src/app/api/rotation/execute/route.ts       | 10 +++++++---
 src/lib/server/resource-service.ts          |  6 ++++--
 3 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/src/app/api/rotation/execute-pixel/route.ts b/src/app/api/rotation/execute-pixel/route.ts
index 9e83a31..20e9684 100644
--- a/src/app/api/rotation/execute-pixel/route.ts
+++ b/src/app/api/rotation/execute-pixel/route.ts
@@ -30,10 +30,11 @@ export async function POST(req: NextRequest) {
     const checklists = await ensurePixelRotationChecklist();
 
     const result = await prisma.$transaction(async (tx) => {
+      // R3: same idempotency guard as the BM route.
       const target = await tx.pixel.findFirst({
-        where: { id: pixelId, brandId },
+        where: { id: pixelId, brandId, status: { not: "BANNED" } },
       });
-      if (!target) throw new Error("Pixel not found for selected brand");
+      if (!target) throw new Error("Pixel not found for selected brand or already banned");
 
       // Banned pixel must vacate its rotation slot (role = null),
       // otherwise it shadows the promoted MAIN in role lookups.
@@ -69,8 +70,9 @@ export async function POST(req: NextRequest) {
             : [];
 
       for (const { from, to } of promotions) {
+        // R1: only healthy backups may take a slot.
         const pixel = await tx.pixel.findFirst({
-          where: { brandId, role: from, status: { not: "BANNED" } },
+          where: { brandId, role: from, status: "ACTIVE" },
         });
         if (!pixel) continue;
 
diff --git a/src/app/api/rotation/execute/route.ts b/src/app/api/rotation/execute/route.ts
index 34fe1d2..f943892 100644
--- a/src/app/api/rotation/execute/route.ts
+++ b/src/app/api/rotation/execute/route.ts
@@ -30,10 +30,12 @@ export async function POST(req: NextRequest) {
     const checklists = await ensureBmRotationChecklist();
 
     const result = await prisma.$transaction(async (tx) => {
+      // R3: re-running on an already-banned BM must fail loudly, not silently
+      // re-ban and mint a duplicate SOP batch.
       const target = await tx.businessManager.findFirst({
-        where: { id: bmId, bmType: "PIXEL" },
+        where: { id: bmId, bmType: "PIXEL", status: { not: "BANNED" } },
       });
-      if (!target) throw new Error("Pixel BM not found");
+      if (!target) throw new Error("Pixel BM not found or already banned");
 
       // Banned BM and its pixels must vacate their rotation slots (role = null),
       // otherwise they shadow the promoted MAIN in role lookups.
@@ -73,8 +75,10 @@ export async function POST(req: NextRequest) {
             : [];
 
       for (const { from, to } of promotions) {
+        // R1: only healthy backups may take a slot — a DISABLED backup promoted
+        // to MAIN is as broken as the banned one it replaces.
         const bm = await tx.businessManager.findFirst({
-          where: { bmType: "PIXEL", role: from, status: { not: "BANNED" } },
+          where: { bmType: "PIXEL", role: from, status: "ACTIVE" },
         });
         if (!bm) continue;
 
diff --git a/src/lib/server/resource-service.ts b/src/lib/server/resource-service.ts
index 93a7be9..4be6a7b 100644
--- a/src/lib/server/resource-service.ts
+++ b/src/lib/server/resource-service.ts
@@ -116,7 +116,8 @@ export const RESOURCE_MAP: Record<ResourceKey, ResourceConfig> = {
         role: body.role || null,
         status: body.status,
       }),
-    disabledData: { status: "BANNED" },
+    // B1: vacate the rotation slot too — status alone recreates "BANNED but MAIN" rows
+    disabledData: { status: "BANNED", role: null },
     rotationEntity: "BM",
     healthEntityType: "BM",
   },
@@ -158,7 +159,8 @@ export const RESOURCE_MAP: Record<ResourceKey, ResourceConfig> = {
         role: body.role,
         status: body.status,
       }),
-    disabledData: { status: "DISABLED" },
+    // B1: same as businessManagers — never leave a role on a disabled pixel
+    disabledData: { status: "DISABLED", role: null },
     rotationEntity: "PIXEL",
     healthEntityType: "PIXEL",
   },
