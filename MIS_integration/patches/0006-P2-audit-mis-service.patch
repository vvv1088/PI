+-- MIS 审计服务账号（patch 0006 配套，Jayden 方案一）。
+-- 目的：writeActionLog 要求 userId 指向 users 表真实行；给 MIS 建一个
+-- 不可登录的占位账号，verifyMisToken 用它的数字 id 合成 session，
+-- MIS 写操作从此进 action_logs（操作人在 details.misOperator）。
+--
+-- 三重不可登录保险：
+--   1. status='INACTIVE' —— 登录查询限定 status='ACTIVE'（login/route.ts）
+--   2. password_hash 不是合法 bcrypt 值 —— bcrypt.compare 恒 false
+--   3. permissions='{}'（空对象）—— 注意绝不能是 NULL：NULL = superadmin 全通行，
+--      这是 users 表最大的坑
+-- 不占席位：INACTIVE 账号不参与正常使用；用户管理页会显示这一行，属预期。
+
+-- 建号（幂等：已存在则跳过）
+INSERT INTO users (username, password_hash, display_name, permissions, status, created_at, updated_at)
+SELECT 'mis-service', 'LOCKED:mis-service-cannot-login', 'MIS Service (API audit)',
+       JSON_OBJECT(), 'INACTIVE', NOW(3), NOW(3)
+FROM DUAL
+WHERE NOT EXISTS (SELECT 1 FROM users WHERE username = 'mis-service');
+
+-- 取 id → 填进 .env 的 MIS_SERVICE_USER_ID，然后重启应用
+SELECT id AS mis_service_user_id, username, status
+FROM users WHERE username = 'mis-service';
+
+-- 复核（应各返回 1 行 / 0 行）
+SELECT COUNT(*) AS should_be_1 FROM users
+WHERE username = 'mis-service' AND status = 'INACTIVE'
+  AND JSON_TYPE(permissions) = 'OBJECT' AND JSON_LENGTH(permissions) = 0;
+SELECT COUNT(*) AS should_be_0 FROM users
+WHERE username = 'mis-service' AND (status = 'ACTIVE' OR permissions IS NULL);
