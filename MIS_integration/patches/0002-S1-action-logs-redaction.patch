index c8b1eb7..600f479 100644
--- a/src/lib/server/action-log.ts
+++ b/src/lib/server/action-log.ts
@@ -2,9 +2,16 @@ import { Prisma } from "@prisma/client";
 import { prisma } from "@/lib/prisma";
 import { getSessionUserId } from "@/lib/server/auth";
 
-function replacer(_key: string, value: unknown): unknown {
+// Secrets must never reach action_logs in full (S1): the details JSON is
+// rendered verbatim on /action-logs for anyone with view permission.
+const SENSITIVE_KEYS = new Set(["token", "appSecret", "passwordHash"]);
+
+function replacer(key: string, value: unknown): unknown {
   if (typeof value === "bigint") return value.toString();
   if (value instanceof Date) return value.toISOString();
+  if (SENSITIVE_KEYS.has(key) && typeof value === "string" && value.length > 8) {
+    return `${value.slice(0, 8)}...`;
+  }
   return value;
 }
 
