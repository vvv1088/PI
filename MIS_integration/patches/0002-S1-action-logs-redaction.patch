diff --git a/db/manual-migrations/20260811_redact_action_logs_secrets.sql b/db/manual-migrations/20260811_redact_action_logs_secrets.sql
new file mode 100644
index 0000000..4c4682c
--- /dev/null
+++ b/db/manual-migrations/20260811_redact_action_logs_secrets.sql
@@ -0,0 +1,26 @@
+-- S1 存量清洗:action_logs.details 里的 token / appSecret / passwordHash 明文
+-- 截断为前 8 位 + "..."。配套代码修复见 patch 0002(新增写入已脱敏)。
+-- 先跑 DRY-RUN 看影响面,确认后再跑 UPDATE。生产实测(2026-08-09)预期 33 条。
+
+-- DRY-RUN:哪些行会被改
+SELECT id, entity_type, action_type, created_at
+FROM action_logs
+WHERE CAST(details AS CHAR) REGEXP '"(token|appSecret|passwordHash)" *: *"[^"]{9,}"';
+
+-- 正式清洗(可重复执行,幂等)
+UPDATE action_logs
+SET details = CAST(
+  REGEXP_REPLACE(
+    REGEXP_REPLACE(
+      REGEXP_REPLACE(
+        CAST(details AS CHAR CHARACTER SET utf8mb4),
+        '"token" *: *"([^"]{8})[^"]{1,}"',        '"token":"\\1..."'),
+      '"appSecret" *: *"([^"]{8})[^"]{1,}"',      '"appSecret":"\\1..."'),
+    '"passwordHash" *: *"([^"]{8})[^"]{1,}"',     '"passwordHash":"\\1..."')
+  AS JSON)
+WHERE CAST(details AS CHAR) REGEXP '"(token|appSecret|passwordHash)" *: *"[^"]{9,}"';
+
+-- 复核:应返回 0 行
+SELECT COUNT(*) AS remaining
+FROM action_logs
+WHERE CAST(details AS CHAR) REGEXP '"(token|appSecret|passwordHash)" *: *"[^"]{9,}"';
