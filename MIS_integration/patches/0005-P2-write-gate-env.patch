MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

根因：原 P2 方案是写接口分批开放，意味着 1–2 周一次小部署、多次排期。
改法：把全部计划内写接口一次做齐，用一个环境变量控制——
1. mis-access.ts：新增 MIS_WRITE_API_PREFIXES 写白名单（brands/business-managers/
   pixels/ad-accounts/developer-apps/pixel-shares/rotation/sop，前缀匹配，
   含 capi-events、fb-accounts、acct-brands 子路由）；MIS_ALLOW_WRITE=1 时
   放行白名单内 POST/PUT/DELETE，token 权限面对应 key 升 edit；
   CORS Allow-Methods 补 POST/DELETE。
2. .env.example：新增 MIS_ALLOW_WRITE=0 说明。
安全边界：默认 0 = 行为与只读版完全一致；tokens/users/action-logs/auth 在
MIS_DENIED_API_PREFIXES 里优先拒绝，无论开关如何永远进不了写白名单；
开写后操作者审计走 X-MIS-User（前一个 commit）。
验证：npx tsc --noEmit 零错误；npm run build 通过。
部署：随本批一次部署;P2 到点只需把 MIS_ALLOW_WRITE 改 1 重启,无需再排代码窗口。
---
 .env.example          |  2 ++
 src/lib/mis-access.ts | 54 +++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/.env.example b/.env.example
index 21aafea..61fc6f7 100644
--- a/.env.example
+++ b/.env.example
@@ -11,3 +11,5 @@ MIS_ALLOWED_ORIGIN=https://ci.boostmarketing.site
 MIS_API_TOKEN=replace-with-48-char-random
 # 设为 1 时额外放行 PUT /api/analytics/spending/remark（报表备注编辑，默认关）
 MIS_ALLOW_REMARK_PUT=0
+# P2 写通道总开关:设 "1" 开放白名单内写接口(资产CRUD/轮转/SOP;tokens/users/action-logs 永远拒绝)。默认 0=只读。
+MIS_ALLOW_WRITE=0
diff --git a/src/lib/mis-access.ts b/src/lib/mis-access.ts
index b385dfc..0d851a4 100644
--- a/src/lib/mis-access.ts
+++ b/src/lib/mis-access.ts
@@ -15,6 +15,11 @@
  *   MIS_API_TOKEN        MIS 专用 service token（建议 ≥48 位随机字符串）
  *   MIS_ALLOW_REMARK_PUT 设为 "1" 时，额外放行 PUT /api/analytics/spending/remark
  *                        （花费报表人工备注；默认关闭，见对接清单 E 节「唯一的写例外」）
+ *   MIS_ALLOW_WRITE      设为 "1" 时开放 P2 写通道：MIS_WRITE_API_PREFIXES 白名单内的
+ *                        POST/PUT/DELETE + 对应权限 key 升为 edit。默认关闭（token 只读）。
+ *                        设计意图：代码一次 review 一次部署，何时开写只是改这一个
+ *                        环境变量重启——不需要再排第二次部署窗口。
+ *                        tokens / users / action-logs / auth 无论开关如何永远拒绝。
  */
 import type { PermissionMap, SessionPayload } from "@/lib/session";
 
@@ -60,6 +65,39 @@ export const MIS_DENIED_API_PREFIXES = [
 
 const REMARK_PUT_PATH = "/api/analytics/spending/remark";
 
+/**
+ * P2 写通道白名单（MIS_ALLOW_WRITE=1 时生效）。前缀匹配，覆盖 MIS 前端全部写入口：
+ * 资产 CRUD（brands 前缀含 capi-events 子路由、business-managers 前缀含 fb-accounts、
+ * ad-accounts 前缀含 acct-brands）、pixel 共享、轮转 execute/execute-pixel、SOP 模板与实例。
+ * 注意 MIS_DENIED_API_PREFIXES 优先级更高：tokens/users/action-logs 永远进不了白名单。
+ */
+export const MIS_WRITE_API_PREFIXES = [
+  "/api/brands",
+  "/api/business-managers",
+  "/api/pixels",
+  "/api/ad-accounts",
+  "/api/developer-apps",
+  "/api/pixel-shares",
+  "/api/rotation",
+  "/api/sop",
+];
+
+/** MIS_ALLOW_WRITE=1 时升为 edit 的权限 key（与写白名单一一对应；health 保持 view） */
+const MIS_WRITE_EDIT_KEYS = [
+  "brands",
+  "business-managers",
+  "pixels",
+  "ad-accounts",
+  "developer-apps",
+  "pixel-shares",
+  "rotation",
+  "sop",
+] as const;
+
+function misWriteEnabled(): boolean {
+  return process.env.MIS_ALLOW_WRITE === "1";
+}
+
 function allowedOrigins(): string[] {
   const raw = process.env.MIS_ALLOWED_ORIGIN;
   if (!raw) return [];
@@ -79,7 +117,7 @@ export function isMisOriginAllowed(origin: string | null): boolean {
 export function misCorsHeaders(origin: string): Record<string, string> {
   return {
     "Access-Control-Allow-Origin": origin,
-    "Access-Control-Allow-Methods": "GET,PUT,OPTIONS",
+    "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS",
     "Access-Control-Allow-Headers": "Authorization, Content-Type, X-MIS-User",
     "Access-Control-Max-Age": "86400",
     Vary: "Origin",
@@ -108,10 +146,15 @@ export function verifyMisToken(authorization: string | null): SessionPayload | n
   const provided = authorization.slice("Bearer ".length).trim();
   if (!provided || !timingSafeEqualStr(provided, expected)) return null;
   const now = Date.now();
+  let perms: PermissionMap = MIS_READONLY_PERMS;
+  if (misWriteEnabled()) {
+    perms = { ...MIS_READONLY_PERMS };
+    for (const k of MIS_WRITE_EDIT_KEYS) perms[k] = "edit";
+  }
   return {
     uid: MIS_SERVICE_UID,
     name: MIS_SERVICE_NAME,
-    perms: MIS_READONLY_PERMS,
+    perms,
     iat: now,
     exp: now + 1000 * 60 * 5, // 每个请求独立校验，exp 仅为满足类型
   };
@@ -137,5 +180,12 @@ export function misRequestViolation(method: string, pathname: string): string |
   ) {
     return null;
   }
+  if (
+    misWriteEnabled() &&
+    (method === "POST" || method === "PUT" || method === "DELETE") &&
+    MIS_WRITE_API_PREFIXES.some((p) => pathname === p || pathname.startsWith(p + "/"))
+  ) {
+    return null;
+  }
   return "service token is read-only";
 }
